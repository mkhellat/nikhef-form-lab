digraph chain4 {
    rankdir=LR;
    graph [fontname="Helvetica", nodesep=0.7, ranksep=1.0, bgcolor="white"];
    node [fontname="Helvetica", fontsize=13];
    edge [fontname="Helvetica", fontsize=13];

    node [shape=point, width=0.09, color=black];
    A; C; D; B;

    node [shape=none, width=0, height=0];
    e_in  [label="e- (p1)  in"];
    g_in  [label="gamma (k0)  in"];
    g1    [label="gamma (k1)  out"];
    g2    [label="gamma (k2)  out"];
    g3    [label="gamma (k3)  out"];
    e_out [label="e- (p2)  out"];

    { rank=same; e_in; g_in; }
    { rank=same; A; }
    { rank=same; g1; }
    { rank=same; C; }
    { rank=same; g2; }
    { rank=same; D; }
    { rank=same; g3; }
    { rank=same; B; }
    { rank=same; e_out; }

    // vertex A: e- in, photon in, internal fermion q1 out (2 fermion + 1 photon)
    e_in -> A;
    g_in -> A [style=dashed, arrowhead=none, penwidth=1.4];
    A -> C [label=" q1", color="#204090", fontcolor="#204090", penwidth=2];

    // vertex C: q1 in, q2 out, photon g1 out (2 fermion + 1 photon)
    C -> g1 [style=dashed, arrowhead=none, penwidth=1.4];
    C -> D [label=" q2", color="#b03030", fontcolor="#b03030", penwidth=2];

    // vertex D: q2 in, q3 out, photon g2 out (2 fermion + 1 photon)
    D -> g2 [style=dashed, arrowhead=none, penwidth=1.4];
    D -> B [label=" q3", color="#208040", fontcolor="#208040", penwidth=2];

    // vertex B: q3 in, e- out, photon g3 out (2 fermion + 1 photon)
    B -> g3 [style=dashed, arrowhead=none, penwidth=1.4];
    B -> e_out;

    label="gamma + e- -> e- + gamma + gamma + gamma  (tree-level, higher order in alpha)\lChain topology A-C-D-B: V=4, E_internal=3 (q1,q2,q3), 6 external legs.\lEvery vertex is a valid QED vertex (2 fermion legs + 1 photon leg).\lCutting any one internal line disconnects the diagram -> tree, L = E-(V-1) = 3-3 = 0.\l";
    labelloc="b";
    fontsize=12;
}
