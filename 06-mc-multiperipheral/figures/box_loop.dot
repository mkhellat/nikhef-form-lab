digraph box_loop {
    rankdir=LR;
    graph [fontname="Helvetica", bgcolor="white", nodesep=1.0, ranksep=1.2, splines=line];
    node [fontname="Helvetica", fontsize=13];
    edge [fontname="Helvetica", fontsize=13];

    node [shape=point, width=0.09, color=black];
    TL; TR; BL; BR;

    node [shape=none, width=0, height=0];
    a1 [label="a1  in"];
    a2 [label="a2  out"];
    b1 [label="b1  in"];
    b2 [label="b2  out"];

    { rank=same; a1; b1; }
    { rank=same; TL; BL; }
    { rank=same; TR; BR; }
    { rank=same; a2; b2; }
    a1 -> TL -> TR -> a2 [style=invis];
    b1 -> BL -> BR -> b2 [style=invis];

    // fermion line a: a1 -> TL -> TR -> a2
    a1 -> TL;
    TR -> a2;

    // fermion line b: b1 -> BL -> BR -> b2
    b1 -> BL;
    BR -> b2;

    // internal fermion segments, one on each fermion line's row (solid)
    TL -> TR [label=" k1", color="#b03030", fontcolor="#b03030", penwidth=2, constraint=false];
    BL -> BR [label=" k2", color="#3060b0", fontcolor="#3060b0", penwidth=2, constraint=false];

    // the two exchanged photons, connecting line a's row to line b's row (dashed)
    TL -> BL [label="k3 ", color="#208040", fontcolor="#208040", penwidth=2, style=dashed, constraint=false];
    TR -> BR [label=" k4", color="#805090", fontcolor="#805090", penwidth=2, style=dashed, constraint=false];

    label="Box diagram: two fermion lines (a1->a2, b1->b2, solid k1/k2) exchanging\ltwo photons (dashed k3/k4). V=4 (TL,TR,BL,BR), E_internal=4 (k1,k2,k3,k4),\l4 external legs. Cutting any ONE internal line leaves the other three still\lconnecting all vertices -> NOT a tree. L = E-(V-1) = 4-3 = 1: one internal\lmomentum (e.g. k3) remains a free (loop) parameter.\l";
    labelloc="b";
    fontsize=12;
}
