digraph multiperipheral {
    rankdir=LR;
    graph [fontname="Helvetica", nodesep=0.6, ranksep=0.9, bgcolor="white"];
    node [fontname="Helvetica", fontsize=13];
    edge [fontname="Helvetica", fontsize=13];

    // external legs as invisible points, vertices as small filled dots
    node [shape=point, width=0.09, color=black];
    A; B; C;

    node [shape=none, width=0, height=0];
    p1 [label="p1  (m1)"];
    p2 [label="p2  (m2)"];
    p3 [label="p3  (m3)"];
    p4 [label="p4  (m4)"];
    p5 [label="p5  (m5)"];

    { rank=same; p2; p1; }
    { rank=same; B; A; }
    { rank=same; p5; p4; p3; }

    p1 -> A [label="  "];
    p2 -> B [label="  "];
    A -> p3;
    B -> p5;
    B -> C [label="q2 = p2 - p5", color="#3060b0", fontcolor="#3060b0", penwidth=2];
    A -> C [label="q1 = p1 - p3", color="#b03030", fontcolor="#b03030", penwidth=2];
    C -> p4;

    // annotate the two possible cuts as a subgraph note
    label="Cutting line q1 isolates {p1,p3} from {p2,p4,p5}: q1 = p1-p3\lCutting line q2 isolates {p2,p5} from {p1,p3,p4}: q2 = p2-p5\l";
    labelloc="b";
    fontsize=12;
}
